# Copy this to car.env and fill in your car's details:  cp car.env.example car.env
# car.env is gitignored on purpose. Do not commit it, this repo is public.

CAR_HOST="192.168.1.x"            # the car's address on the Wi-Fi, not the lidar's wired net
CAR_USER="your-car-username"
CAR_WS="~/f1tenth_ws"             # the ROS workspace on the car
CAR_ODOM="/odom"
CAR_RMW="rmw_cyclonedds_cpp"      # our car's stack needs CycloneDDS; FastDDS crashes it

# SAFETY: our car's drive mux has no autonomous lock. Anything published on /drive
# moves the car immediately, with no button held. Stop it with: rr car-stop
